//
//  Project.xcconfig
//  Kawarin
//
//  プロジェクト共通のビルド設定。
//  テンプレートから新規リポジトリを作成したら、まずこのファイルの値を書き換える。
//  （pbxproj 側にはこれらの値を直接書かず、ここだけを編集する）
//

// Apple Developer Program の Team ID
DEVELOPMENT_TEAM = XU74X3434S

// アプリ本体の Bundle Identifier。
// テストターゲットは $(APP_BUNDLE_IDENTIFIER).Tests / .UITests として派生させる
APP_BUNDLE_IDENTIFIER = jp.shilokuma.Kawarin

// バージョン（CFBundleShortVersionString / CFBundleVersion）
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// 最低サポート OS（docs/DESIGN.md の「1. 決定事項」）。visionOS は visionOS のターゲットを足すときに XROS_DEPLOYMENT_TARGET = 2.0 を足す
IPHONEOS_DEPLOYMENT_TARGET = 18.0
MACOSX_DEPLOYMENT_TARGET = 15.0

// Mac 版は Apple Silicon のみ（Intel Mac の検証をしないため）
ARCHS[sdk=macosx*] = arm64

// Mac アプリ（KawarinMac）の entitlements。カメラ拡張を入れる com.apple.developer.system-extension.install と App Group は
// provisioning profile が要り、profile の無いアドホック署名では「requires a provisioning profile」でビルドが止まる。
// app-kit の macOS の Archive はアドホック署名（CODE_SIGN_STYLE=Manual）にするので、自動の署名（Xcode が profile を用意する）のときだけ付ける。
// 配布（TestFlight・App Store）の Archive には、app-kit が Archive の後に、自動の署名で読んだこのファイルの項目を足す
KAWARIN_MAC_ENTITLEMENTS_Automatic = KawarinMac/KawarinMac.entitlements
KAWARIN_MAC_ENTITLEMENTS_Manual =
